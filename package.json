{
	"name": "cross-vault-sync",
	"version": "0.1.2",
	"description": "Keep notes synchronized across multiple Obsidian vaults using the sync_targets frontmatter property.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "tsc -p test && vitest run --coverage",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.17",
		"@vitest/coverage-v8": "^5.0.5",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/spec-reporter": "^9.32.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^30.1.3",
		"mocha": "^10.8.2",
		"obsidian": "latest",
		"obsidian-test-mocks": "^7.2.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.5",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0"
	}
}
